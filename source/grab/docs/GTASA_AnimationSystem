4. Task-Animation Integration
This is the key part for your grab system! Tasks control when and what animations play.
4.1 CTaskSimpleAnim (Base Class)
From TaskSimpleAnim.h:12-30:
class CTaskSimpleAnim : public CTaskSimple {
    CAnimBlendAssociation* m_pAnim;  // The animation this task controls
    union {
        struct {
            bool m_bIsFinished : 1;      // Animation completed
            bool m_bDontInterrupt : 1;   // Can't be aborted
            bool m_bHoldLastFrame : 1;   // Freeze on last frame
            bool m_bDontBlendOut : 1;    // Don't fade out when done
        };
    };
};
4.2 CTaskSimpleRunAnim - The Core Pattern
From TaskSimpleRunAnim.cpp:52-69:
bool CTaskSimpleRunAnim::ProcessPed(CPed* ped) {
    if (m_bIsFinished)
        return true;
    // Only start animation if not already playing
    if (!m_pAnim && !RpAnimBlendClumpGetAssociation(ped->m_pRwClump, m_nAnimId))
        StartAnim(ped);
    return m_bIsFinished;
}
void CTaskSimpleRunAnim::StartAnim(CPed* ped) {
    // BlendAnimation handles fading out conflicting anims automatically
    m_pAnim = CAnimManager::BlendAnimation(ped->m_pRwClump, m_nAnimGroup, m_nAnimId, m_fBlendDelta);
    m_pAnim->SetFinishCallback(CTaskSimpleAnim::FinishRunAnimCB, this);  // Notify task when done
}
4.3 Animation Finish Callback
The task gets notified when the animation finishes:
// From TaskSimpleAnim.cpp (conceptual)
void CTaskSimpleAnim::FinishRunAnimCB(CAnimBlendAssociation* anim, void* data) {
    auto task = static_cast<CTaskSimpleAnim*>(data);
    task->m_bIsFinished = true;  // Mark task as complete
}

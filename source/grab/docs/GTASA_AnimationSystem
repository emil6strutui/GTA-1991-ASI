7. Practical Example: How BlendAnimation Works
When you call CAnimManager::BlendAnimation(), here's what happens (from AnimManager.cpp:488-538):
CAnimBlendAssociation* BlendAnimation(RpClump* clump, AssocGroupId groupId, AnimationId animId, float blendDelta) {
    // 1. Check if this animation is already playing
    CAnimBlendAssociation* running = FindRunningAnim(clump, groupId, animId);
    
    // 2. Fade out conflicting animations
    for (auto& anim : clump->animations) {
        if (anim != running && anim.IsPartial() == toBlendIsPartial) {
            // Calculate negative blend delta to fade out
            anim.m_BlendDelta = std::min(-0.05f, anim.GetBlendAmount() * -blendDelta);
            anim.SetFlag(ANIMATION_IS_BLEND_AUTO_REMOVE);  // Delete when faded
        }
    }
    
    // 3. If already running, just restart if finished
    if (running) {
        running->SetBlendDelta((1.f - running->m_BlendAmount) * blendDelta);
        if (running->HasFinished()) running->Start();
        return running;
    }
    
    // 4. Create new animation instance
    auto anim = new CAnimBlendAssociation(toBlendStaticAssoc);
    anim->Start();
    anim->SetBlend(0.f, blendDelta);  // Start at 0, fade in
    return anim;
}

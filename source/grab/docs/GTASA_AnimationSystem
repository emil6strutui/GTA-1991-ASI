5. The Animation Update Loop
Every frame, the animation system updates like this:
// Simplified from RpAnimBlend.cpp - called from CPed::ProcessAnimGroups()
void RpAnimBlendClumpUpdateAnimations(RpClump* clump, float timeStep) {
    // 1. Update time for all animations
    for (auto& assoc : clump->animations) {
        assoc.UpdateTimeStep(timeStep);  // Calculate time delta
        assoc.UpdateTime(timeStep);       // Advance playback, check completion
    }
    
    // 2. For each bone/frame
    for (auto& frameData : clump->frameData) {
        CQuaternion finalRot{};
        CVector finalTrans{};
        
        // 3. Blend all animation contributions
        for (auto& assoc : clump->animations) {
            auto& node = assoc.GetNodeForBone(frameData.boneId);
            
            CQuaternion rot;
            CVector trans;
            node.Update(trans, rot, blendWeight);  // Interpolate keyframes
            
            finalRot += rot;    // Sum weighted rotations
            finalTrans += trans; // Sum weighted translations
        }
        
        finalRot.Normalise();
        frameData.KeyFrame->q = finalRot;
        frameData.KeyFrame->t = finalTrans;
    }
    
    // 4. Update blend amounts (fade in/out)
    for (auto& assoc : clump->animations) {
        assoc.UpdateBlend(timeStep);  // May delete if faded out
    }
}
